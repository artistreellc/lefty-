{
  "name": "lefty-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared context MCP server for Claude + Grok building the isolated Arbo sandbox",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
